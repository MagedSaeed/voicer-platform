{
  "sentences": [
    {
      "unique_id": "1",
      "text": "طلبت أكل وليلحين ما يت الطلبية",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "2",
      "text": "يدتي قالت أن أمس عمتي وصلت البيت متأخر وقالت أنها حتاجت أتييب ولدها من الحضانه",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "3",
      "text": "قوموا نسير نحوط فالفريج و نرد",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "4",
      "text": "تو ما نور المكان حياكم",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "5",
      "text": "امس مريت اخذلي قهوه بس قالولي ماشي بن، ف سرت مكان ثاني",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "6",
      "text": "هاتيلي غرشة ماي معاج و انتي راده",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "7",
      "text": "باجر بروح دبي ويا ربيعاتي",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "8",
      "text": "هلا والله سلام عليكم محمد كيفك؟ اقلك تعرف وين الحمام؟ ياخي تعال أنا فل كلاس",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "9",
      "text": "البارحه ما نمت عدل وييت الجامعه من وقت اليوم وحسيت بتعب وصداع وما لي خلق",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "10",
      "text": "شو عندك مسطن عند الباب طوف",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "11",
      "text": "باجر تعالي عندنا خاطريه نتيمع",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "12",
      "text": "اقولج تخيلي شو استوا اليوم",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "13",
      "text": "البارحه كنت تعبانه من الجامعه",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "14",
      "text": "لو اتشوفون فاتورة ٢٠٠ درهم هو ها الخاتم مطلي فظى. حسيته وايد حلو فخذته كهديه حق نفسي",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "15",
      "text": "امس كنت وايد يوعانه لدرجة خذتلي اكل وانا راده البيت ماقدرت اتريا",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "16",
      "text": "بسير صوب هليه بتين معايه",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "17",
      "text": "شو رايج نروح ناخذ كوفي اليوم المغرب",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "18",
      "text": "تراني مشغوله الحين، بكلمج بعدين",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "19",
      "text": "انا اليوم معزومه عند يارتيه",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "20",
      "text": "امس جيت البيت متاخره،كنت تعبانه للاخر",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "21",
      "text": "وديني بيت امايه نسلم عليها",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "22",
      "text": "خلصت أول امتحان، الثاني بخلصه ان شاء الله الساعة ٢٣٠، وبوصل البيت ٣",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "23",
      "text": "بتيين معانا نسير نقعد فالرمله",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "24",
      "text": "خالو موزة مب هني، بس الأولاد هني. أعطي عبدالله",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "25",
      "text": "باي عقب شوي انا بعدني في الطريق",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "26",
      "text": "سير الشيشه عبي موتري بترول",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "27",
      "text": "برايكن لاتون الصبح تعالن العصر",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "28",
      "text": "بنسرح من بوظبي و بنروح العين",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "29",
      "text": "امس كنت اتعشى في البيت",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "30",
      "text": "امس كنت اتعشى في البيت",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "31",
      "text": "امس كنت اتعشى في البيت",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "32",
      "text": "امس كنت اتعشى في البيت",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "33",
      "text": "امس كنت اتعشى في البيت",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "34",
      "text": "امس كنت اتعشى في البيت",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "35",
      "text": "امس كنت اتعشى في البيت",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "36",
      "text": "امس كنت اتعشى في البيت",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "37",
      "text": "امس كنت اتعشى في البيت",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "38",
      "text": "رحت البحر و رديت عطشانه",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "39",
      "text": "كنت رايح العب بادل امس فليل",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "40",
      "text": "الجو كان بارد وجميل يوم كنت العب كورة قدم",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "41",
      "text": "في الصباح الجامعة كانت زحمة",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "42",
      "text": "ماحصلت موقف في الجامعة الا بعد نصف ساعة",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "43",
      "text": "الدكتور كان مب حاضر في المحاضره اول دقيقه",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "44",
      "text": "صليت الظهر في مصلي الجامعة",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "45",
      "text": "شربت شراب بروتين بعد الجم",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "46",
      "text": "سويت غدا مجبوس في البيت",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "47",
      "text": "سويت سلطة مفيده حق الغدا",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "48",
      "text": "لعبت في البليستيشن قليلا على العصر",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "49",
      "text": "ذهبت الي الحديريات و اجرت سيكل",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "50",
      "text": "سقطت عندما كنت اسوق السيكل",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "51",
      "text": "استيقظت باكرا شربت قهوة صباحا",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "52",
      "text": "قرأت كتابا جميلا في البيت",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "53",
      "text": "ذهبت مع صديق الى السوق",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "54",
      "text": "مارست رياضة خفيفة مساء امس",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "55",
      "text": "شاهدت فيلما طويلا بعد العشاء",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "56",
      "text": "حليت واجبات قليله قبل النوم",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "57",
      "text": "نمت مبكرا بسبب تعب شديد",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "58",
      "text": "تحدثت مع عائلتي وقت العشاء",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "59",
      "text": "طبخت وجبة بسيطة في المطبخ",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "60",
      "text": "خرجت للمشي حول الحي مساء",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "61",
      "text": "استمعت موسيقى هادئة اثناء العم",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "62",
      "text": "استمعت موسيقى هادئة اثناء العمل",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "63",
      "text": "رتبت غرفتي ونظفت المكتب جيدا",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "64",
      "text": "تعلمت مهارة جديدة عبر الانترنت",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "65",
      "text": "شربت ماء كثير بعد التمرين",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "66",
      "text": "أنا بسير ارقد لان باجر عندي محاضرة بالجامعة",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "67",
      "text": "عيل لازم نسير هناك عشان نسوي هالمعاملة الحكومية",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "68",
      "text": "نشيت اليوم من وقت، و أنضغطت في الجامعة و تعبت وايد",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "69",
      "text": "ليش ما يبت القهوة عشان الكشتة",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "70",
      "text": "والله امس ابطيت في الجامعه مامدانيه اسير صوب الربع، ولا فوق هذا كله السياره بندت ف مارمت اسوي شي امس",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "71",
      "text": "عيل برمسه باجر عشان اجوف إذا هو فاضي ولا لا",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "72",
      "text": "لازم نروح صلاة اليمعة باجر",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "73",
      "text": "لا اجوف هالشي تسويه مره ثانية",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "74",
      "text": "قلت بخلي المشوار لباجر لاني ماكنت فاضي اليوم. البارحه سرت مهرجان الحصن و كان وايد وناسه بس زحمه. شو رايج نطلع نطلع ناخذ قهوه",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "75",
      "text": "امس ييت البيت متأخر، كنت وايد تعبانه",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "76",
      "text": "ماعندنا شي اسمه مستحيل علني افداك",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "77",
      "text": "امس وصلت البيت متأخره ، الانه كنت في دبي",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "78",
      "text": "تعبان وايد والله مافيني انش",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "79",
      "text": "الجو امس كان وايد حلو",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "80",
      "text": "نشيت الصبح تعبانه، خذت دواء",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "81",
      "text": "امس سرت بيت خالتيه و رديت عشر فاليل",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "82",
      "text": "اليوم يت الجامعه من الصبح و كان يوم طويل",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "83",
      "text": "امس تعشيت مكدونالدز و صل بارد",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "84",
      "text": "بنروح المول بعد الغدا تجهزوا",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "85",
      "text": "ليش تبند الخط في ويهي",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "86",
      "text": "اتفقنا نطلع فجأة وبدون تخطيط",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "87",
      "text": "وين سرتوا امس؟ أنا سرت الحصن",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "88",
      "text": "مهرجان قصر الحصن وايد حلو يستاهل الزياره",
      "dialect": [
        "ae-ad"
      ],
      "source": "UAE",
      "source_dialect": ""
    },
    {
      "unique_id": "89",
      "text": "عندج قلم؟، نسيت مالي فالسياره",
      "dialect": [
        "ae-ad"
